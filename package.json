{
  "name": "siyuan-card-note",
  "version": "0.1.1",
  "description": "A lightweight card note capture plugin for SiYuan.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/make-package.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev:harness": "vite --config vite.test.config.ts",
    "test": "node scripts/test-daily-markdown.mjs && node scripts/test-editor-model.mjs && node scripts/test-editor-actions.mjs && node scripts/test-review.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "card-note",
    "markdown"
  ],
  "author": "onebean",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.11.30",
    "siyuan": "^1.2.1",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.5",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "vite": "^5.2.0"
  }
}
